# Copy to .env.local and fill in. Never commit .env.local.

# --- Admin panel --------------------------------------------------------------
# password for /admin/login
ADMIN_PASSWORD=
# long random string: openssl rand -hex 32
SESSION_SECRET=
# shared secret between the bot and the web server: openssl rand -hex 32
BOT_API_KEY=
# Required before customers can save bank accounts or wallet addresses.
# Generate with: openssl rand -base64 32
CUSTOMER_DATA_ENCRYPTION_KEY=

# --- Telegram bot ---------------------------------------------------------------
# from @BotFather
TELEGRAM_BOT_TOKEN=
# comma-separated Telegram chat IDs that receive new-trade alerts
STAFF_CHAT_IDS=
# where the bot reaches the web server
API_BASE_URL=http://localhost:3000
# The web server restarts the bot, rate worker and rate bot when they stop
# (backend/supervisor.ts). Set to "off" when pm2 or similar runs them instead;
# ecosystem.config.cjs already does.
ORBITAL_SUPERVISOR=

# --- Rate-updates channel bot -----------------------------------------------------
# a SECOND bot from @BotFather, added to the channel as an admin that can post
TELEGRAM_RATE_BOT_TOKEN=
# one or more channels: comma-separated @channelusername or numeric IDs (-100...)
RATE_CHANNEL_ID=
# comma-separated post times, Nigerian time (WAT)
RATE_POST_TIMES=00:00,12:00

# --- Public site ----------------------------------------------------------------
# e.g. https://orbital.ng (link previews, bot "Track it" links)
SITE_URL=
# production only: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Global market ticker (homepage) ---------------------------------------------
# Optional. The ticker works without a key; a free CoinGecko "demo" key
# (coingecko.com/en/api) gives a steadier rate limit.
COINGECKO_API_KEY=

# --- Bybit (rate engine) ----------------------------------------------------------
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ASK_SIDE=0
# Bybit's two official hosts are api.bybit.com and api.bytick.com. If the one
# set here can't be reached, the other is tried automatically.
BYBIT_BASE_URL=https://api.bybit.com
# Optional: a specific fallback host, or "off" to never fall back.
# BYBIT_FALLBACK_BASE_URL=https://api.bytick.com
# per upstream call: 1–3 attempts and 1–60 seconds are accepted
BYBIT_REQUEST_TIMEOUT_MS=15000
BYBIT_MAX_ATTEMPTS=3

# --- Rates & margins ----------------------------------------------------------------
# seconds between worker refreshes
RATE_REFRESH_INTERVAL=600
# crash-safe worker lease; must exceed the maximum expected refresh duration
RATE_REFRESH_LOCK_SECONDS=300
# how long a normal quote is valid
QUOTE_EXPIRATION_SECONDS=60
# how long a seller's rate is held before they send
SELL_RATE_LOCK_SECONDS=900
# older rates are hidden and not quoted
MAX_RATE_AGE_SECONDS=1800
# percentage | fixed
ORBITAL_MARGIN_MODE=percentage
ORBITAL_BUY_MARGIN=1
ORBITAL_SELL_MARGIN=1
ORBITAL_BULK_BUY_MARGIN=1
ORBITAL_BULK_SELL_MARGIN=1
ORBITAL_BULK_THRESHOLD_NGN=2000000
# Cost of swapping a non-USDT coin to or from USDT on Bybit, as a % of the
# trade: added to buy prices and taken off sell prices for BTC, ETH, SOL and
# USDC (never USDT). 0.2 = Bybit's 0.1% spot fee plus 0.1% for spread and
# price movement. 0 switches it off.
ORBITAL_CONVERSION_COST_PERCENT=0.2
